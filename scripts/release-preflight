#!/usr/bin/env bash
# Check a release before its tag is pushed: what the release workflow
# (.github/workflows/release-macos.yml) would refuse, or get wrong, caught
# here first.
#
#   scripts/release-preflight            for the tag app-v<workspace version>
#   scripts/release-preflight app-v0.5.0 for the tag you are about to push
#
# It builds the bundle the workflow builds (universal when both Rust
# targets are installed, into target/release/bundle/Jiji.app) and reads the
# repository's secret names and visibility through `gh` when it is signed
# in. Nothing is published, tagged or changed.
set -euo pipefail

cd "$(dirname "$0")/.."
WORKFLOW=.github/workflows/release-macos.yml
TARGET="${CARGO_TARGET_DIR:-target}"
APP="$TARGET/release/bundle/Jiji.app"

blockers=0
warnings=0
ok() { printf 'ok       %s\n' "$1"; }
warn() { warnings=$((warnings + 1)); printf 'warning  %s\n' "$1"; }
fail() { blockers=$((blockers + 1)); printf 'blocker  %s\n' "$1"; }
note() { printf 'skipped  %s\n' "$1"; }

# The version and the tag, read the way the workflow reads them.
VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"
TAG="${1:-app-v$VERSION}"
if [[ "$TAG" == "app-v$VERSION" ]]; then
  ok "tag $TAG matches the workspace version $VERSION"
else
  fail "tag $TAG does not match the workspace version $VERSION: the workflow refuses it"
fi
if tagged="$(git rev-parse -q --verify "refs/tags/$TAG^{commit}" 2>/dev/null)"; then
  if [[ "$tagged" == "$(git rev-parse HEAD)" ]]; then
    ok "$TAG is tagged on the commit being released"
  else
    fail "$TAG already tags another commit: $VERSION has shipped, so set a new version"
  fi
fi

# The release notes, and the notes the updater shows, are the version's
# own changelog section.
notes="$(awk -v heading="## $VERSION" '
  index($0, heading) == 1 { found = 1; next }
  found && /^## / { exit }
  found { print }
' CHANGELOG.md | tr -d '[:space:]')"
if [[ -n "$notes" ]]; then
  ok "CHANGELOG.md has a section for $VERSION"
else
  fail "CHANGELOG.md has no \"## $VERSION\" section with notes in it"
fi

# Every installed copy reads the feed the app names: it must be this
# repository's latest release.
origin="$(git remote get-url origin 2>/dev/null || true)"
repo="$(printf '%s\n' "$origin" | sed -En 's#^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+/[^/]+)$#\2#p')"
repo="${repo%.git}"
feed="$(sed -n 's/^const ENDPOINT: &str = "\(.*\)";/\1/p' crates/jiji-desktop/src/host/update.rs)"
if [[ -z "$repo" ]]; then
  fail "origin ($origin) is not a GitHub repository"
elif [[ "$feed" == "https://github.com/$repo/releases/latest/download/latest.json" ]]; then
  ok "the update feed is $repo's latest release"
else
  fail "the update feed is $feed, not $repo's latest release"
fi

# Both slices of the universal binary.
missing=()
installed="$(rustup target list --installed 2>/dev/null || true)"
for target in aarch64-apple-darwin x86_64-apple-darwin; do
  if grep -qx "$target" <<<"$installed"; then
    ok "Rust target $target is installed"
  else
    missing+=("$target")
    fail "Rust target $target is not installed (rustup target add $target)"
  fi
done

# The bundle, as the workflow builds it. Without both targets this Mac's
# own slice still shows whether the bundle builds and holds together.
log="$(mktemp -t jiji-preflight)"
if [[ ${#missing[@]} -eq 0 ]]; then
  build=(env JIJI_UNIVERSAL=1 scripts/bundle.sh)
  archs="arm64 x86_64"
else
  build=(scripts/bundle.sh)
  archs="$(uname -m)"
  warn "building this Mac's slice only ($archs): the universal build needs both targets"
fi
if "${build[@]}" >"$log" 2>&1; then
  ok "the bundle builds: $APP"
else
  fail "the bundle does not build; the end of its log ($log):"
  tail -20 "$log" | sed 's/^/         /'
fi

if [[ -d "$APP" ]]; then
  plist="$APP/Contents/Info.plist"
  if lint="$(plutil -lint "$plist" 2>&1)"; then
    ok "Info.plist is well formed"
  else
    fail "Info.plist is not: $lint"
  fi
  shown="$(plutil -extract CFBundleShortVersionString raw "$plist" 2>/dev/null || true)"
  if [[ "$shown" == "$VERSION" ]]; then
    ok "the bundle says it is $VERSION"
  else
    fail "the bundle says it is ${shown:-no version}, not $VERSION"
  fi
  # The system checks the bundle's floor, the loader each slice's.
  floor="$(plutil -extract LSMinimumSystemVersion raw "$plist" 2>/dev/null || true)"
  binary="$APP/Contents/MacOS/jiji-desktop"
  for arch in $archs; do
    minos="$(vtool -arch "$arch" -show-build "$binary" 2>/dev/null | awk '$1 == "minos" { print $2 }')"
    if [[ -z "$minos" ]]; then
      fail "the binary has no $arch slice"
    elif [[ "$minos" == "$floor" ]]; then
      ok "the $arch slice is built for macOS $floor, the bundle's floor"
    else
      fail "the $arch slice is built for macOS $minos, but the bundle declares $floor"
    fi
  done
  if verified="$(codesign --verify --deep --strict "$APP" 2>&1)"; then
    ok "codesign verifies the bundle"
  else
    fail "codesign does not verify the bundle: $verified"
  fi
fi

# What only GitHub knows. Names only: secret values are never readable.
if ! command -v gh >/dev/null; then
  note "gh is not installed: the repository's secrets and visibility are not checked"
elif ! gh auth token >/dev/null 2>&1; then
  note "gh is not signed in (gh auth login): the repository's secrets and visibility are not checked"
elif [[ -n "$repo" ]]; then
  if names="$(gh secret list --repo "$repo" --json name --jq '.[].name' 2>/dev/null)"; then
    for secret in $(grep -o 'secrets\.[A-Z_]*' "$WORKFLOW" | sed 's/^secrets\.//' | sort -u); do
      if grep -qx "$secret" <<<"$names"; then
        ok "secret $secret is set"
      elif [[ "$secret" == TAURI_SIGNING_PRIVATE_KEY_PASSWORD ]]; then
        warn "secret $secret is not set: right only if the updater key has no password"
      else
        fail "secret $secret is not set"
      fi
    done
  else
    fail "gh cannot list $repo's secrets"
  fi
  case "$(gh repo view "$repo" --json isPrivate --jq .isPrivate 2>/dev/null || true)" in
    false) ok "$repo is public, so its releases can be downloaded and update checks reach them" ;;
    true) fail "$repo is private: downloads and update checks need public releases" ;;
    *) fail "gh cannot see $repo" ;;
  esac
fi

echo
if [[ "$blockers" -gt 0 ]]; then
  echo "Not ready: $blockers blocker(s), $warnings warning(s)."
  exit 1
fi
echo "Ready to tag $TAG: $warnings warning(s)."
